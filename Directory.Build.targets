<Project>
  <Target Name="SingPlusAdmissionVerify" AfterTargets="Build" Condition="'$(SingPlusEnableAdmission)' == 'true' and '$(SingPlusAdmissionRoot)' != '' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SingPlusAdmissionTool>$(MSBuildThisFileDirectory)tools/SingPlus.Admission/bin/$(Configuration)/net10.0/SingPlus.Admission.dll</_SingPlusAdmissionTool>
      <_SingPlusAdmissionProof>$(IntermediateOutputPath)SingPlusAdmissionProofV1.json</_SingPlusAdmissionProof>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(_SingPlusAdmissionTool)&quot; verify --assembly &quot;$(TargetPath)&quot; --root &quot;$(SingPlusAdmissionRoot)&quot; --profile &quot;$(SingPlusMemoryProfile)&quot; --proof &quot;$(_SingPlusAdmissionProof)&quot;" />
  </Target>
</Project>
