<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>YAKSys_Hybrid_CPU.ExecutableAdapter</RootNamespace>
    <AssemblyName>HybridCpu_ExecutableAdapter</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HybridCPU.ExternalRuntime.Contracts" Version="1.3.0" />
    <PackageReference Include="HybridCPU.ExternalRuntime" Version="1.3.0" />
    <ProjectReference Include="../Runtime/HybridCPU_NeutralRuntime/HybridCPU_NeutralRuntime.Contracts/HybridCPU_NeutralRuntime.Contracts.csproj" />
  </ItemGroup>
  <Target Name="RejectForbiddenAdapterProjectReferences" BeforeTargets="ResolveProjectReferences">
    <Error
      Condition="'%(ProjectReference.Filename)' == 'HybridCPU_NeutralRuntime.Model' Or '%(ProjectReference.Filename)' == 'HybridCPU_NeutralRuntime'"
      Text="The executable adapter must not reference the ModelOnly facade or compatibility aggregator." />
    <Error
      Condition="$([System.String]::Copy('%(ProjectReference.FullPath)').Contains('HybridCPU v2'))"
      Text="Direct sibling HybridCPU-v2 project references are forbidden; use a versioned external facade/package." />
  </Target>
</Project>
